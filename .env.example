# 复制为 .env 供 docker compose 读取变量（或直接设置系统环境变量）
# docker compose 自动从同目录 .env 插值 ${VAR}

# ---------- 必改（生产） ----------
JWT_SECRET=please-generate-a-random-secret-at-least-32-bytes-long
CREDENTIAL_ENCRYPT_KEY=please-generate-a-random-32-bytes-key

# ---------- AI ----------
DEEPSEEK_API_KEY=sk-xxx
AI_ENABLED=true
# 模型：deepseek-flash（V4.1-Flash）/ deepseek-v4-pro
DEEPSEEK_MODEL=deepseek-flash
